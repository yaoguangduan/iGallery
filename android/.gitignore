gradle-wrapper.jar
/.gradle
/captures/
/gradlew
/gradlew.bat
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# ...except the debug keystore, which is committed on purpose. The SDK generates
# that file per machine, so leaving it out means a new laptop signs with a new key
# and every installed build refuses the update. It holds no secret beyond the
# identity itself: the passwords are Android's public debug constants. A real
# release key would still be caught by the rules above.
!app/debug.keystore
